<mxfile host="app.diagrams.net"><diagram name="TRPG流程"><mxGraphModel page="1" pageWidth="1240" pageHeight="1060"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="AI TRPG：行动、生成与恢复流程" style="text;html=1;fontSize=26;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="45" as="geometry" /></mxCell><mxCell id="lane0" value="用户" style="swimlane;startSize=38;fillColor=#F3F6FA;strokeColor=#D9E2EC;fontSize=18;" vertex="1" parent="1"><mxGeometry x="25" y="102" width="280" height="710" as="geometry" /></mxCell><mxCell id="lane1" value="桌面端规则与状态" style="swimlane;startSize=38;fillColor=#F3F6FA;strokeColor=#D9E2EC;fontSize=18;" vertex="1" parent="1"><mxGeometry x="320" y="102" width="305" height="710" as="geometry" /></mxCell><mxCell id="lane2" value="AI 网关" style="swimlane;startSize=38;fillColor=#F3F6FA;strokeColor=#D9E2EC;fontSize=18;" vertex="1" parent="1"><mxGeometry x="645" y="102" width="270" height="710" as="geometry" /></mxCell><mxCell id="lane3" value="模型" style="swimlane;startSize=38;fillColor=#F3F6FA;strokeColor=#D9E2EC;fontSize=18;" vertex="1" parent="1"><mxGeometry x="940" y="102" width="275" height="710" as="geometry" /></mxCell><mxCell id="a" value="输入自然语言行动" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="50" y="145" width="230" height="65" as="geometry" /></mxCell><mxCell id="b" value="理解行动／校验规则" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="350" y="145" width="245" height="65" as="geometry" /></mxCell><mxCell id="c" value="执行判定并提交状态" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="245" height="65" as="geometry" /></mxCell><mxCell id="d" value="生成叙事请求／组装上下文" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="350" y="355" width="245" height="65" as="geometry" /></mxCell><mxCell id="e" value="模型接入／调用与检索" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="660" y="355" width="235" height="65" as="geometry" /></mxCell><mxCell id="f" value="生成叙事内容" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="960" y="355" width="230" height="65" as="geometry" /></mxCell><mxCell id="g" value="返回内容／记录调用元数据" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="660" y="465" width="235" height="65" as="geometry" /></mxCell><mxCell id="h" value="接收并展示生成结果" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="350" y="465" width="245" height="65" as="geometry" /></mxCell><mxCell id="i" value="查看结果／继续行动" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="50" y="465" width="230" height="65" as="geometry" /></mxCell><mxCell id="j" value="生成失败：返回错误" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="660" y="575" width="235" height="65" as="geometry" /></mxCell><mxCell id="k" value="沿用已提交结果重试" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="350" y="575" width="245" height="65" as="geometry" /></mxCell><mxCell id="l" value="选择历史检查点" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="50" y="720" width="230" height="65" as="geometry" /></mxCell><mxCell id="m" value="创建恢复副本／保留原历史" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#6A8DAD;" vertex="1" parent="1"><mxGeometry x="350" y="720" width="245" height="65" as="geometry" /></mxCell><mxCell id="edge0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#52677c;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#52677c;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#52677c;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#52677c;" edge="1" parent="1" source="d" target="e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#52677c;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#52677c;" edge="1" parent="1" source="f" target="g"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#52677c;" edge="1" parent="1" source="g" target="h"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#52677c;" edge="1" parent="1" source="h" target="i"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#52677c;" edge="1" parent="1" source="e" target="j"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#52677c;" edge="1" parent="1" sourc