{
  "name": "ai-trpg-engine-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "test": "bun test --isolate",
    "typecheck": "tsc -b --noEmit",
    "build:renderer": "vite build",
    "build:main": "bun scripts/build.ts",
    "build": "bun run build:renderer && bun run build:main",
    "dev": "bun scripts/dev.ts",
    "rebuild:native": "bun scripts/rebuild-native.ts",
    "postinstall": "bun scripts/rebuild-native.ts",
    "persist:check": "bun scripts/persist-check.ts",
    "gold": "bun scripts/gold-path.ts",
    "cloud:check": "bun scripts/cloud-provider-check.ts",
    "checkpoint:check": "bun scripts/checkpoint-check.ts",
    "demo:e2e": "bun scripts/mist-harbor-e2e.ts",
    "package:win": "bun scripts/package-win.ts",
    "content:pack": "bun scripts/scenario-pack.ts pack boarding-house",
    "content:check": "bun scripts/scenario-pack.ts check",
    "pack:lint": "bun scripts/pack-lint.ts",
    "card:check": "bun scripts/card-check.ts",
    "mist:check": "bun scripts/mist-harbor-check.ts",
    "kernel:check": "bun scripts/kernel-check.ts",
    "architecture:check": "bun scripts/architecture-check.ts",
    "keeper:check": "bun scripts/keeper-check.ts",
    "store:check": "bun scripts/store-check.ts",
    "smoke": "bun scripts/pack-lint.ts && bun scripts/smoke.ts && bun scripts/kernel-check.ts && bun scripts/architecture-check.ts && bun scripts/keeper-check.ts"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "better-sqlite3": "^12.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.3.1",
    "esbuild": "^0.25.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
