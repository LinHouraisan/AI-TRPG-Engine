# 脚本侧模型配置（bun run rag:build / bench:synth / bench 读这里）。
# Bun 会自动加载 electron/.env，无需 dotenv。此文件已被 .gitignore 忽略。

# ── 对话模型（叙述、评测集合成、裁判打分）────────────────────
# DeepSeek 用 https://api.deepseek.com，模型名 deepseek-flash
LC_PROTOCOL=openai_compatible
LC_BASE_URL=https://api.deepseek.com
LC_MODEL=deepseek-flash
LC_API_KEY=
# LC_TIMEOUT_MS=120000
# LC_TEMPERATURE=0.7

# ── 向量化（RAG 建索引、检索时把 query 转向量）──────────────────
# DeepSeek 没有 /embeddings 接口，必须另指一家。按你实际有的服务改。
# 例：硅基流动  https://api.siliconflow.cn/v1  模型 BAAI/bge-m3
# 例：智谱      https://open.bigmodel.cn/api/paas/v4  模型 embedding-3
# 例：本机 Ollama 则把 LC_EMBED_PROTOCOL 设为 ollama，模型 bge-m3
LC_EMBED_PROTOCOL=openai_compatible
LC_EMBED_BASE_URL=
LC_EMBED_MODEL=
LC_EMBED_API_KEY=
