---
import Doc from "../layouts/Doc.astro";
import { groups } from "../data/nav";

const blurb: Record<string, string> = {
  总览: "手册的目录与阅读顺序。",
  用户故事: "分玩家、守秘人、实现者三类，每条都配有例子和验收。",
  一晚怎么跑: "说话 → 根据玩家意图调用工具 → 程序裁定 → 条件 → 守秘人说话。",
  房间与出口: "门厅、书房、楼梯平台。人与物在同一时刻只能位于一处。",
  道具总表: "记下名称、说明、里面有什么、能做什么；相关的事件或地点留给守秘人。",
  剧情与标记: "关键情节的五种状态：未开放、可进行、已完成、已失败、被替代。",
  事件开关: "沿用 RPG Maker 的说法：开关、独立开关、变量、事件页。",
  条件: "逐条对照已经提交的状态来判定；一旦成立，就在同一笔提交里改状态。",
  数据结构: "键名一律用英文；每张表都用中文说明它的含义、给谁看，并附一个例子。",
  数值与工具调用: "调查员卡是只读的，生命值、理智、位置只能经工具调用来改。",
  存档与读档: "一份存档由当前状态和事件记录组成；只有聊天记录不能当正式读档。",
  样例剧本: "《寄宿公寓账本》，平面图与调查员卡都可以一步步走完。",
};
---

<Doc title="总览">
  <h1>AI TRPG Engine 手册</h1>
  <p class="lead">
    这是一套跑在本地桌面、以对话为主的引擎。生命值、理智、位置这类数字，只能经由工具调用来修改；下次接着玩时，依据的是当前状态和事件记录，而不是聊天窗口里的内容。文中的例子统一取自《寄宿公寓账本》。
  </p>
  {
    groups.map((group) => (
      <section>
        <h2>{group.title}</h2>
        <div class="cards">
          {group.pages
            .filter((p) => p.href !== "/")
            .map((p) => (
              <a class="card" href={p.href}>
                <span class="kicker">{group.title}</span>
                <h3>{p.title}</h3>
                <p>{blurb[p.title]}</p>
              </a>
            ))}
        </div>
      </section>
    ))
  }
</Doc>
