---
import Doc from "../layouts/Doc.astro";

const stories = [
  {
    who: "玩家",
    title: "开一晚新局",
    want: "选定一个剧本、建好一名调查员，从门厅开场，当晚就能开跑。",
    ex: "选择《寄宿公寓账本》，调查员是记者林晚。门厅的钟停在九点；她的生命值 11、理智 65、开锁 45，背包是空的，人在门厅。",
    ok: "界面上同时给出对话、调查员卡和当前房间，而卡上的生命值与理智不能手动修改。",
  },
  {
    who: "玩家",
    title: "平常说话就能行动",
    want: "像平时说话那样写「我推开书房门」或「我试着开锁」，就能让角色行动。",
    ex: "玩家写「我进书房看看桌上那把锁」，程序先把她移动到书房，再对书桌锁执行观察。",
    ok: "同一句话不会既判定开锁成功、又让账本仍然锁在桌里；平面图上的人与物必须和调查员卡一致。",
  },
  {
    who: "玩家",
    title: "看见检定",
    want: "能看到掷的是哪一项技能，以及点数、难度和成败。",
    ex: "开锁检定：技能 45，掷出 42，难度 60，判定失败。叙述可以写锁芯响了一声，但不能写锁开了。",
    ok: "对话里给出检定结果，事件记录中留下一条「检定失败」，道具的位置保持不变。",
  },
  {
    who: "玩家",
    title: "中途离开，下周接着玩",
    want: "先存档，读档之后房间、背包、已知线索和理智都还在。",
    ex: "周五取走账本后存档；周日读档时，林晚仍在书房，背包里有黑色账本，已经知道港口交易时间，理智 60，女房东在门厅警戒。",
    ok: "读档依据的是当前状态和事件记录；缺少事件记录的存档不能作为正式读档。",
  },
  {
    who: "玩家",
    title: "导出一份能给别人看的记录",
    want: "把当前状态和事件记录导出来，发给朋友，或者自己留一份副本。",
    ex: "导出的是一份数据包，里面有调查员卡、三个房间里的人与物、已经发生的行动，以及已完成的关键情节。",
    ok: "导出之后再导入，平面图和数据卡都与导出前完全相同。",
  },
  {
    who: "守秘人",
    title: "改一处房规，也要留下痕迹",
    want: "把开锁难度从 60 改成 40 时，要记下一笔：谁改的、改前多少、改后多少。",
    ex: "执行「应用房规」，把书桌锁的难度改为 40，理由是锁已经锈蚀；事件记录里写明谁改的、改前与改后的数值。",
    ok: "调查员卡和锁的状态仍然只能经工具调用更新，没有对应记录的改动一律视为无效。",
  },
  {
    who: "实现者",
    title: "模型只提出调用",
    want: "让模型只负责提出工具调用，由程序来掷骰、校验条件并提交当前状态。",
    ex: "模型输出「把账本放到背包」，但书桌仍然锁着，于是程序拒绝这次调用，并记下「行动被拒：书桌未开」。",
    ok: "生命值、理智、位置和背包都不提供可编辑的输入框。",
  },
];
---

<Doc title="用户故事">
  <h1>用户故事</h1>
  <p class="lead">每条故事都说明谁想做什么、要做到什么程度，后面再跟上一条能够逐项核对的验收。</p>
  <div class="story-grid">
    {
      stories.map((s) => (
        <article class="story">
          <span class="badge">{s.who}</span>
          <h3>{s.title}</h3>
          <p>{s.want}</p>
          <div class="pair">
            <div>
              <span class="kicker">例子</span>
              {s.ex}
            </div>
            <div>
              <span class="kicker">验收</span>
              {s.ok}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Doc>
