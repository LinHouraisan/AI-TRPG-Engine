---
import { schemaById } from "../data/schemas";

const { id } = Astro.props;
const schema = schemaById(id);
if (!schema) throw new Error(`unknown schema ${id}`);

function pretty(sample: string): string {
  try {
    return JSON.stringify(JSON.parse(sample), null, 2);
  } catch {
    return sample;
  }
}
---

<div class="sheet-block">
  <p class="step-label" style="margin:0">{schema.note}</p>
  <pre><code>{pretty(schema.sample)}</code></pre>
  <div class="fields" role="table">
    <div class="field field-head" role="row">
      <span>键</span>
      <span>意思</span>
      <span>给谁</span>
      <span>例子</span>
    </div>
    {
      schema.fields.map((row) => (
        <div class="field" role="row">
          <code>{row.key}</code>
          <span>{row.meaning}</span>
          <span class="chip">{row.who}</span>
          <span class="field-ex">{row.example}</span>
        </div>
      ))
    }
  </div>
</div>
