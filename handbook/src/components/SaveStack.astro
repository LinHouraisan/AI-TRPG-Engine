---
const events = [
  "1 · 移动：门厅 → 书房",
  "2 · 检定开锁失败（42 / 60）",
  "3 · 条件：女房东到门厅",
  "4 · 检定开锁成功",
  "5 · 账本：书房 → 背包",
  "6 · 得知港口交易时间",
  "7 · 理智 −5",
];
---

<div class="demo" id="save-stack">
  <div class="layers">
    <section class="layer">
      <h3>当前状态</h3>
      <p class="step-label" style="margin:0">书房 · 生命值 11 · 理智 60 · 背包有账本 · 女房东在门厅 · 已过 6 分钟</p>
    </section>
    <section class="layer">
      <h3>事件记录</h3>
      <p class="step-label" style="margin:0 0 0.4rem">只追加，不改写；读档时可以按编号重放。</p>
      <div class="timeline">
        {events.map((e, n) => <div class="ev" data-ev={n}>{e}</div>)}
      </div>
    </section>
    <section class="layer">
      <h3>摘要（可选）</h3>
      <p class="step-label" style="margin:0">例如「第 5 条：取走账本」。摘要必须指回事件编号，不能代替记录本身。</p>
    </section>
  </div>
  <div class="demo-toolbar">
    <button type="button" data-replay>按记录重放</button>
    <button type="button" class="ghost" data-reset>清空高亮</button>
    <span class="step-label" data-label>点一下重放，看这七条事件怎样叠成当前状态</span>
  </div>
</div>

<script>
  const root = document.getElementById("save-stack");
  if (root) {
    let t = null;
    let i = -1;
    const rows = [...root.querySelectorAll("[data-ev]")];

    function paint() {
      rows.forEach((el, n) => el.classList.toggle("on", n <= i));
      root.querySelector("[data-label]").textContent =
        i < 0 ? "尚未重放" : `已重放到第 ${i + 1} 条`;
    }

    root.querySelector("[data-replay]")?.addEventListener("click", () => {
      i = -1;
      paint();
      clearInterval(t);
      t = setInterval(() => {
        i += 1;
        paint();
        if (i >= rows.length - 1) clearInterval(t);
      }, 450);
    });
    root.querySelector("[data-reset]")?.addEventListener("click", () => {
      clearInterval(t);
      i = -1;
      paint();
    });
  }
</script>
