---
import { ITEMS, backlinks } from "../data/items";

const cards = ITEMS.map((item) => ({
  ...item,
  links: backlinks(item.id),
}));
---

<div class="demo" id="item-catalog" data-items={JSON.stringify(cards)}>
  <div class="demo-toolbar">
    <button type="button" id="view-player">玩家所见</button>
    <button type="button" class="ghost" id="view-keeper">守秘人所见</button>
    <span class="step-label" id="view-label">当前是玩家视角：只显示说明和可做的事，秘密不会出现。</span>
  </div>
  <div class="item-grid" id="item-grid"></div>
  <div class="act-card" id="item-links"></div>
</div>

<script>
  const root = document.getElementById("item-catalog");
  if (root) {
    const items = JSON.parse(root.dataset.items ?? "[]");
    let keeper = false;
    let selected = 0;

    const factName = {
      "fact.lock_dc": "书桌锁很难开",
      "fact.dock_time": "港口交易在凌晨三点",
    };

    function draw() {
      document.getElementById("view-label").textContent = keeper
        ? "当前是守秘人视角：包含秘密、能推动什么，以及相关的事件或地点。"
        : "当前是玩家视角：只显示说明和可做的事，秘密不会出现。";
      document.getElementById("view-player")?.classList.toggle("ghost", keeper);
      document.getElementById("view-keeper")?.classList.toggle("ghost", !keeper);

      const grid = document.getElementById("item-grid");
      if (!grid) return;
      grid.innerHTML = items
        .map((item, i) => {
          const actions = item.actions
            .map((a) => {
              const extra = a.skill ? ` · ${a.skill}${a.dc ? " / " + a.dc : ""}` : "";
              return `<span class="chip">${a.verb}${extra}</span>`;
            })
            .join("");
          const inside = item.contains.length
            ? item.contains.map((id) => items.find((x) => x.id === id)?.name ?? id).join("、")
            : "（无）";
          const secrets = keeper
            ? item.keeper.secrets.length
              ? item.keeper.secrets.map((s) => `<span class="chip warn">${s}</span>`).join("")
              : `<span class="chip empty">无秘密</span>`
            : "";
          return `<article class="item-card ${i === selected ? "on" : ""}" data-i="${i}">
            <span class="kicker">${item.atName}</span>
            <h3>${item.name}</h3>
            <p>${item.description}</p>
            <p class="step-label" style="margin:0.45rem 0 0.2rem">里面有 · ${inside}</p>
            <p class="step-label" style="margin:0.2rem 0">可拿取 · ${item.takeable ? "可以" : "不可以"}</p>
            <div class="chips" style="margin-top:0.4rem">${actions}</div>
            ${keeper ? `<p class="step-label" style="margin:0.55rem 0 0.2rem">守秘人</p><p class="step-label" style="margin:0">${item.keeper.notes}</p><div class="chips" style="margin-top:0.4rem">${secrets}</div>` : ""}
          </article>`;
        })
        .join("");

      const item = items[selected];
      const links = item.links;
      const box = document.getElementById("item-links");
      if (!box) return;
      const reveal = links.reveals.map((id) => factName[id] ?? id);
      box.innerHTML = `
        <div class="act-head"><span class="badge">相关</span><strong>${item.name}</strong></div>
        <div class="act-stage">
          <div class="prop-box">装在 · ${links.contained_in.length ? links.contained_in.join("、") : "房间里"}</div>
          <span class="act-arrow">→</span>
          <div class="prop-box on">${item.name}</div>
          <span class="act-arrow">能推动</span>
          <div class="prop-box ${keeper ? "on" : ""}">${links.enables.length ? links.enables.join("、") : "（无）"}</div>
        </div>
        <p class="step-label" style="margin:0.7rem 0 0">相关事件或地点 · ${
          links.related.length
            ? links.related.map((r) => `${r.kind}：${r.name}`).join("；")
            : "（无）"
        }</p>
        <p class="step-label" style="margin:0.2rem 0 0">线索来源 · ${reveal.length ? reveal.join("、") : "（无）"}</p>
        ${keeper ? "" : `<p class="step-label" style="margin:0.45rem 0 0">玩家一侧不显示秘密，也不显示「能推动」里尚未揭开的内容。点「守秘人所见」可以查看完整的表。</p>`}
      `;
    }

    document.getElementById("item-grid")?.addEventListener("click", (e) => {
      const t = e.target.closest("[data-i]");
      if (!t) return;
      selected = Number(t.dataset.i);
      draw();
    });
    document.getElementById("view-player")?.addEventListener("click", () => {
      keeper = false;
      draw();
    });
    document.getElementById("view-keeper")?.addEventListener("click", () => {
      keeper = true;
      draw();
    });
    draw();
  }
</script>
