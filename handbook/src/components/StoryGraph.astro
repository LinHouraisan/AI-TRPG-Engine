---
const nodes = [
  { id: "lock", title: "发现书桌难开", ready: "调查员在书房", done: "已知：书桌锁很难开" },
  { id: "take", title: "取走账本", ready: "书桌已开，账本仍在书房", done: "账本在背包；标记「书桌已开」" },
  { id: "read", title: "读懂交易时间", ready: "背包里有账本", done: "已知：港口交易在凌晨三点；可去码头" },
];
---

<div class="demo" id="story-graph" data-nodes={JSON.stringify(nodes)}>
  <div class="demo-toolbar">
    <button type="button" data-prev>上一步</button>
    <button type="button" data-next>下一步</button>
    <span class="step-label" data-label>开场</span>
  </div>
  <div class="nodes">
    {
      nodes.map((n) => (
        <article class="node locked" data-node={n.id}>
          <div class="st" data-st>未开放</div>
          <strong>{n.title}</strong>
          <p class="step-label" style="margin:0.35rem 0 0">可进行：{n.ready}</p>
          <p class="step-label" style="margin:0.15rem 0 0">完成后：{n.done}</p>
        </article>
      ))
    }
  </div>
  <p class="step-label" data-note></p>
</div>

<script>
  const root = document.getElementById("story-graph");
  if (root) {
    const labels = ["开场", "进入书房", "取走账本", "读懂交易时间", "把账本交还（被替代）"];
    const notes = [
      "三条关键情节都还未开放，调查员仍在门厅。",
      "调查员进入书房，「发现书桌难开」变为可进行，观察之后即告完成。",
      "开锁成功，「取走账本」完成，下一条随之变为可进行。",
      "读完账本，「读懂交易时间」完成。",
      "如果把账本交给女房东，「读懂交易时间」就变为被替代，并另记一条「账本已交还」；两条不会同时算作完成。",
    ];
    const states = [
      { lock: "locked", take: "locked", read: "locked" },
      { lock: "done", take: "locked", read: "locked" },
      { lock: "done", take: "done", read: "ready" },
      { lock: "done", take: "done", read: "done" },
      { lock: "done", take: "done", read: "replaced" },
    ];
    const words = {
      locked: "未开放",
      ready: "可进行",
      done: "已完成",
      fail: "已失败",
      replaced: "被替代",
    };
    let i = 0;

    function render() {
      root.querySelector("[data-label]").textContent = `${i + 1} / ${labels.length} · ${labels[i]}`;
      root.querySelector("[data-note]").textContent = notes[i];
      for (const el of root.querySelectorAll("[data-node]")) {
        const id = el.getAttribute("data-node");
        const st = states[i][id];
        el.className = `node ${st}`;
        el.querySelector("[data-st]").textContent = words[st];
      }
    }

    root.querySelector("[data-prev]")?.addEventListener("click", () => {
      i = Math.max(0, i - 1);
      render();
    });
    root.querySelector("[data-next]")?.addEventListener("click", () => {
      i = Math.min(states.length - 1, i + 1);
      render();
    });
    render();
  }
</script>
