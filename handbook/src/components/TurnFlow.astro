---
const steps = [
  { n: "1", title: "玩家说话", body: "我推开书房门。" },
  { n: "2", title: "根据玩家意图调用工具", body: "移动：门厅 → 书房。" },
  { n: "3", title: "程序裁定", body: "确认存在出口「房门」，于是写入事件，并把当前位置改为书房。" },
  { n: "4", title: "条件", body: "这一步没有条件成立；如果有，改动会并入同一笔提交。" },
  {
    n: "5",
    title: "守秘人说话",
    html: `<p class="kicker">守秘人</p>
<p>门开了。你站在书房里。窗帘没拉开，桌上压着一把黄铜锁，锁后似乎有本册子。</p>
<p class="step-label">能做的事：看看这把锁、试着开锁，或者从房门回到门厅。</p>`,
  },
];

const fail = [
  { n: "1", title: "玩家说话", body: "我撬这把锁。" },
  { n: "2", title: "根据玩家意图调用工具", body: "检定：开锁，难度 60。" },
  { n: "3", title: "程序裁定", body: "掷出 42，判定失败。账本仍在书房，时间推进 2 分钟。" },
  { n: "4", title: "条件", body: "开锁失败且已过三分钟 → 女房东走到门厅，并加上标记「女房东已警戒」。" },
  {
    n: "5",
    title: "守秘人说话",
    html: `<p class="kicker">守秘人</p>
<p>锁芯响了一下，没开。楼上织针停了片刻。账本还在桌里。</p>
<p class="step-label">能做的事：再试一次、先行离开，或者听听楼上的动静。</p>`,
  },
];
---

<div class="demo" id="turn-flow" data-ok={JSON.stringify(steps)} data-fail={JSON.stringify(fail)}>
  <div class="demo-toolbar">
    <button type="button" id="ex-ok">例子：进书房</button>
    <button type="button" class="ghost" id="ex-fail">例子：开锁失败</button>
  </div>
  <div class="flow" id="flow-btns"></div>
  <div class="callout" id="flow-body"></div>
</div>

<script>
  const root = document.getElementById("turn-flow");
  if (root) {
    const ok = JSON.parse(root.dataset.ok ?? "[]");
    const fail = JSON.parse(root.dataset.fail ?? "[]");
    let pack = ok;
    let i = 0;
    const btns = document.getElementById("flow-btns");
    const body = document.getElementById("flow-body");

    function draw() {
      if (!btns || !body) return;
      btns.innerHTML = pack
        .map(
          (s, n) =>
            `<button type="button" class="${n === i ? "on" : ""}" data-i="${n}"><span class="n">第 ${s.n} 步</span><strong>${s.title}</strong></button>`,
        )
        .join("");
      const step = pack[i];
      if (step.html) body.innerHTML = step.html;
      else body.textContent = step.body;
    }

    btns?.addEventListener("click", (e) => {
      const t = e.target.closest("[data-i]");
      if (!t) return;
      i = Number(t.dataset.i);
      draw();
    });
    document.getElementById("ex-ok")?.addEventListener("click", () => {
      pack = ok;
      i = 0;
      draw();
    });
    document.getElementById("ex-fail")?.addEventListener("click", () => {
      pack = fail;
      i = 0;
      draw();
    });
    draw();
  }
</script>
